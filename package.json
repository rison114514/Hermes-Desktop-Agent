{
  "name": "hermes-desktop-agent",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Cross-platform desktop assistant for Hermes ACP.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run dev:windows",
    "dev:windows": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron:windows\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:windows": "wait-on tcp:5173 file:dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "postinstall": "node scripts/ensure-electron-runtime.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable zip --x64",
    "create:mac-launcher": "./scripts/create-macos-launcher.sh",
    "test:core": "npm run build:main && node scripts/verify-core.mjs",
    "preview": "vite preview",
    "electron:preview": "npm run electron:windows",
    "electron:windows": "cross-env ELECTRON_IS_DEV=0 electron ."
  },
  "build": {
    "appId": "com.hermes.desktop-agent",
    "productName": "Hermes Desktop Agent",
    "directories": {
      "output": "release-build"
    },
    "npmRebuild": false,
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/icon.*",
      "!node_modules/cpu-features/**",
      "!node_modules/ssh2/lib/protocol/crypto/build/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mods",
        "to": "mods",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.hermes-mod-config.json",
          "!**/.hermes-mod-enabled.json"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "katex": "^0.16.45",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "simple-git": "^3.36.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.5"
  }
}
